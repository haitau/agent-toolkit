{
  "$schema": "https://opencode.ai/config.json",
  // 规则接入：opencode 不读 rules 目录（V2 仅发现 AGENTS.md + instructions 字段），SSOT 规则经此挂载；
  // skills 由官方发现位 .agents/skills 原生发现，无需链接。
  //
  // V2 原生格式：providers / agents / permissions 有序数组 / mcp.servers；small_model 由内置
  // 隐藏 title agent 承接（agents.title.model）。
  //
  // 订阅 SSOT 说明：providers 段（除 ollama 外）由 agents:sync 从 .claude/settings.*.json 订阅快照
  // 动态生成后注入下方 SUBSCRIPTION_PROVIDERS 占位符，本模板不持有任何 token / baseURL / 模型清单。
  // model / agents.*.model 同样从快照槽位推导（占位符），换模型只改 .claude 快照。
  // 新增订阅：.claude 下加一份 settings.<name>.json + agents.config.json 的 providers 注册一行。
  "instructions": [".agents/rules/*.md"],
  "model": "{{OPENCODE_MODEL}}",
  "providers": {
    {{SUBSCRIPTION_PROVIDERS}}
    // 本地 Ollama 模型（OpenAI 兼容端点，非订阅、不入快照，按需手维护或删除本段）
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "local-model:latest": {
          "name": "Local LLM (Ollama)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
      // MCP 档位：由 agents:sync 从 agents.config.json 的 mcp.profiles 按 .machine-state.json
      // （profile + disabled）渲染注入下方占位符，本模板不持有 server 清单。
      "servers": {
      {{MCP_OPENCODE_BLOCK}}
      }
  },
  "agents": {
    "title": {
      // 承接 V1 small_model：会话标题生成的内置隐藏 agent
      "model": "{{OPENCODE_SMALL_MODEL_REF}}"
    },
    "general": {
      "mode": "subagent",
      "model": "{{OPENCODE_SMALL_MODEL_REF}}"
    },
    "explore": {
      "mode": "subagent",
      "model": "{{OPENCODE_SMALL_MODEL_REF}}"
    }
  },
  "permissions": [
    // 黑名单反转模式（2026-09-14 主仓经验移植；V2 有序数组语义）：默认放行，危险门 ask 前置确认（once/always/reject）。
    // 最后匹配生效，宽规则在前、例外在后；action 更名 bash→shell，write 并入 edit，list 已不存在；
    // 复合命令（&&/||/;）由 scanner 拆分逐条校验，中缀通配两种实现下均能命中，堵住 "cd x && rm -rf y" 绕过。
    // deny 仅 git clean（清未跟踪文件无 git 兜底可回滚）。
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    // V1 顶层 external_directory 键 → V2 permission action：项目根外读写不再逐次确认（私人机，风险由 git 可回滚兜底）
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*sudo*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -fr*", "effect": "ask" },
    { "action": "shell", "resource": "*git clean*", "effect": "deny" },
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    { "action": "shell", "resource": "*git reset --hard*", "effect": "ask" }
  ]
}
